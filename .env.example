# Copiez ce fichier en .env (à la racine, à côté de docker-compose.yml) pour
# personnaliser la configuration Docker. Toutes les valeurs ont un défaut de dev.

# --- PostgreSQL ---
POSTGRES_USER=famylife
POSTGRES_PASSWORD=famylife
POSTGRES_DB=famylife

# --- API ---
# En production : mettez une vraie clé secrète (openssl rand -hex 32).
SECRET_KEY=dev-secret-change-me
ENVIRONMENT=development
