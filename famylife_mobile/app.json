{
  "expo": {
    "name": "FamiLyfe",
    "slug": "famylife_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "famylife",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "hostType": "lan",
    "ios": {
      "bundleIdentifier": "com.famylife.famylife",
      "supportsTablet": true,
      "infoPlist": {
        "NSContactsUsageDescription": "FamiLyfe utilise vos contacts pour retrouver facilement les membres de votre famille déjà inscrits et les ajouter à votre maison."
      }
    },
    "android": {
      "package": "com.famylife.famylife",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2F6E5B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2F6E5B",
          "dark": {
            "backgroundColor": "#245546"
          }
        }
      ],
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "FamiLyfe utilise vos contacts pour retrouver facilement les membres de votre famille déjà inscrits et les ajouter à votre maison."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FamiLyfe utilise vos photos pour changer votre avatar ou ajouter une photo preuve à une activité."
        }
      ],
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "FamiLyfe ajoute les événements de votre foyer à votre calendrier pour que vous les retrouviez directement dans l'app Calendrier de votre téléphone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "apiUrlLocal": "http://localhost:8005",
      "apiUrlRemote": "https://familyfe.dkpsolution.tech/api",
      "eas": {
        "projectId": "9a74bea4-1ad6-49ca-ad3c-26514e37c004"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "kpedeade1997",
    "updates": {
      "url": "https://u.expo.dev/9a74bea4-1ad6-49ca-ad3c-26514e37c004"
    }
  }
}
