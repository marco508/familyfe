# FamiLyfe mobile — variables d'environnement (optionnel)
#
# L'app détecte automatiquement l'IP LAN du serveur Metro pour joindre le
# backend FastAPI en Expo Go (voir app/src/services/apiClient.ts). Ces
# variables ne sont utiles que pour forcer une URL fixe (ex: build de prod).
#
# URL du backend en développement local
EXPO_PUBLIC_API_URL_LOCAL=http://localhost:8005
# URL du backend distant (prod / staging)
EXPO_PUBLIC_API_URL_REMOTE=http://localhost:8005
