# Copiez ce fichier en .env pour personnaliser la configuration.
# Toutes ces valeurs ont un défaut de dev : l'app démarre sans .env.

# --- JWT ---
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
TOKEN_EXPIRE_DAYS=7

# --- Base de données ---
# SQLite par défaut : aucun serveur externe requis (fichier local famylife.db).
DATABASE_URL=sqlite+aiosqlite:///./famylife.db

# --- CORS (dev : tout autorisé pour Expo Go) ---
CORS_ORIGINS=*
CORS_ORIGIN_REGEX=.*

# --- Serveur ---
HOST=0.0.0.0
PORT=8005
ENVIRONMENT=development
# Crée les tables au démarrage si elles n'existent pas (dev uniquement).
AUTO_CREATE_TABLES=True
ROOT_PATH=
